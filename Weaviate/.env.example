# ── Neo4j ──────────────────────────────────────────────────────────────────
# This is the password for the LOCAL Neo4j container — you're setting it,
# not retrieving it. The default below works as-is, change it if you want.
NEO4J_PASSWORD=campaignlens
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ── Weaviate ───────────────────────────────────────────────────────────────
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080

# ── YouTube Data API ───────────────────────────────────────────────────────
# Only needed for 0_scraper.py. If you already have analysis_results.csv, leave this blank.
YOUTUBE_API_KEY=

# ── MLflow ─────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5001
